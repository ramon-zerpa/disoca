---
import { site } from "../../data/site";
---

<section id="nosotros" class="relative px-5 md:px-10 py-24 md:py-36">
  <div class="flex items-baseline justify-between font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-[#fafafa]/50 mb-12">
    <span class="text-[#ea580c]">01 / Nosotros</span>
    <span class="hidden sm:inline">Manifiesto</span>
  </div>

  <p class="font-[Archivo] font-black uppercase leading-[0.95] tracking-[-0.03em] text-[clamp(1.9rem,5.2vw,4.6rem)] max-w-6xl">
    Evaluamos necesidades. Ejecutamos
    <span class="text-[#ea580c]">ingeniería</span>,
    <span class="text-[#ea580c]">procura</span> y
    <span class="text-[#ea580c]">construcción</span>. Instaladores y operadores especializados desde {site.since}.
  </p>

  <div class="grid md:grid-cols-2 gap-px bg-[#262626] border border-[#262626] mt-16 md:mt-24">
    <article class="bg-[#0a0a0a] p-8 md:p-12 group hover:bg-[#111111] transition-colors duration-300">
      <div class="flex items-center justify-between mb-8">
        <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-[#ea580c]">[ Visión ]</span>
        <span class="font-mono text-[10px] text-[#fafafa]/30">01-A</span>
      </div>
      <p class="text-[#fafafa]/75 leading-relaxed text-sm md:text-base">{site.vision}</p>
    </article>
    <article class="bg-[#0a0a0a] p-8 md:p-12 group hover:bg-[#111111] transition-colors duration-300">
      <div class="flex items-center justify-between mb-8">
        <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-[#ea580c]">[ Misión ]</span>
        <span class="font-mono text-[10px] text-[#fafafa]/30">01-B</span>
      </div>
      <p class="text-[#fafafa]/75 leading-relaxed text-sm md:text-base">{site.mission}</p>
    </article>
  </div>

  <figure class="mt-16 md:mt-24 relative overflow-hidden border border-[#262626]">
    <img
      src={site.empresaImage}
      alt="Instalaciones DISOCA"
      class="w-full h-64 md:h-[28rem] object-cover grayscale-[25%] hover:grayscale-0 hover:scale-[1.02] transition-all duration-700"
      loading="lazy"
    />
    <figcaption class="absolute bottom-0 left-0 right-0 flex justify-between items-center px-5 md:px-8 py-3 bg-[#0a0a0a]/80 backdrop-blur-sm font-mono text-[10px] tracking-[0.2em] uppercase text-[#fafafa]/60">
      <span>Fig. 01 — Operaciones DISOCA</span>
      <span class="text-[#ea580c]">Barinas, Venezuela</span>
    </figcaption>
  </figure>
</section>
