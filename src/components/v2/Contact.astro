---
import { site } from "../../data/site";
---

<section id="contacto" class="border-t border-[#262626] px-5 md:px-10 py-24 md:py-36">
  <div class="flex items-baseline justify-between font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-[#fafafa]/50 mb-12">
    <span class="text-[#ea580c]">08 / Contacto</span>
    <span class="hidden sm:inline">4 países — 1 equipo</span>
  </div>

  <h2 class="font-[Archivo] font-black uppercase leading-[0.85] tracking-[-0.04em] text-[clamp(3rem,10vw,9rem)] mb-14 md:mb-20">
    Hablemos<span class="text-[#ea580c]">.</span>
  </h2>

  <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
    <!-- Oficinas -->
    <div class="border-t border-[#262626]">
      {
        site.offices.map((office, i) => (
          <details class="group border-b border-[#262626]" open={i === 0}>
            <summary class="flex items-center justify-between gap-4 py-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
              <span class="flex items-baseline gap-4">
                <span class="font-mono text-xs text-[#ea580c]">0{i + 1}</span>
                <span class="font-[Archivo] font-black uppercase tracking-tight text-xl md:text-3xl group-hover:text-[#ea580c] transition-colors">
                  {office.country}
                </span>
              </span>
              <span class="font-mono text-lg text-[#fafafa]/40 group-open:rotate-45 transition-transform">+</span>
            </summary>
            <dl class="pb-8 pl-9 md:pl-10 space-y-4 font-mono text-[11px] md:text-xs leading-relaxed text-[#fafafa]/60">
              <div>
                <dt class="uppercase tracking-[0.2em] text-[#ea580c] mb-1">Dirección</dt>
                <dd>{office.address}</dd>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <dt class="uppercase tracking-[0.2em] text-[#ea580c] mb-1">Teléfono</dt>
                  <dd>{office.phone}</dd>
                </div>
                <div>
                  <dt class="uppercase tracking-[0.2em] text-[#ea580c] mb-1">Horario</dt>
                  <dd>{office.schedule}</dd>
                </div>
              </div>
              <div>
                <dt class="uppercase tracking-[0.2em] text-[#ea580c] mb-1">Correo</dt>
                <dd>
                  <a href={`mailto:${site.email}`} class="underline underline-offset-4 hover:text-[#ea580c] transition-colors">
                    {site.email}
                  </a>
                </dd>
              </div>
            </dl>
          </details>
        ))
      }
    </div>

    <!-- Formulario -->
    <div>
      <p class="font-mono text-[11px] tracking-[0.2em] uppercase text-[#fafafa]/50 mb-8">
        [ Escríbenos — respuesta en 24-48h ]
      </p>
      <form class="space-y-8" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
        <div class="group">
          <label for="v2-name" class="font-mono text-[10px] tracking-[0.2em] uppercase text-[#fafafa]/50 block mb-2">
            01 — Nombre
          </label>
          <input
            id="v2-name"
            type="text"
            name="name"
            required
            placeholder="Tu nombre"
            class="w-full bg-transparent border-b border-[#262626] focus:border-[#ea580c] outline-none py-3 text-lg placeholder:text-[#fafafa]/25 transition-colors"
          />
        </div>
        <div class="group">
          <label for="v2-email" class="font-mono text-[10px] tracking-[0.2em] uppercase text-[#fafafa]/50 block mb-2">
            02 — Email
          </label>
          <input
            id="v2-email"
            type="email"
            name="email"
            required
            placeholder="tu@email.com"
            class="w-full bg-transparent border-b border-[#262626] focus:border-[#ea580c] outline-none py-3 text-lg placeholder:text-[#fafafa]/25 transition-colors"
          />
        </div>
        <div class="group">
          <label for="v2-message" class="font-mono text-[10px] tracking-[0.2em] uppercase text-[#fafafa]/50 block mb-2">
            03 — Mensaje
          </label>
          <textarea
            id="v2-message"
            name="message"
            rows="4"
            required
            placeholder="Cuéntanos sobre tu proyecto…"
            class="w-full bg-transparent border-b border-[#262626] focus:border-[#ea580c] outline-none py-3 text-lg placeholder:text-[#fafafa]/25 transition-colors resize-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="group w-full md:w-auto inline-flex items-center justify-center gap-4 font-mono text-[11px] tracking-[0.2em] uppercase bg-[#ea580c] text-white px-10 py-5 hover:bg-[#fafafa] hover:text-[#0a0a0a] transition-colors duration-200 cursor-pointer"
        >
          Enviar mensaje
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </button>
      </form>

      <div class="mt-12 pt-8 border-t border-[#262626] flex flex-wrap gap-x-10 gap-y-4 font-mono text-[11px] tracking-[0.15em] uppercase">
        <a
          href={`https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.message)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#fafafa]/60 hover:text-[#ea580c] transition-colors"
        >
          WhatsApp ↗
        </a>
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[#fafafa]/60 hover:text-[#ea580c] transition-colors"
        >
          Instagram ↗
        </a>
        <a href={`mailto:${site.email}`} class="text-[#fafafa]/60 hover:text-[#ea580c] transition-colors">
          {site.email} ↗
        </a>
      </div>
    </div>
  </div>
</section>
