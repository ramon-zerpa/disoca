---
import { site } from "../../data/site";
---

<section class="border-y border-[#262626] px-5 md:px-10 py-24 md:py-36 bg-[#0d0d0d]">
  <div class="flex items-baseline justify-between font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-[#fafafa]/50 mb-12">
    <span class="text-[#ea580c]">06 / Proceso</span>
    <span class="hidden sm:inline">Método integrado</span>
  </div>

  <h2 class="font-[Archivo] font-black uppercase leading-[0.85] tracking-[-0.04em] text-[clamp(2.6rem,8vw,7.5rem)] mb-14 md:mb-20">
    Proceso<br /><span class="text-transparent [-webkit-text-stroke:2px_#fafafa]">integrado</span>
  </h2>

  <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-px bg-[#262626] border border-[#262626]">
    {
      site.process.map((step, i) => (
        <article class="group relative bg-[#0d0d0d] p-7 md:p-9 hover:bg-[#ea580c] transition-colors duration-300 min-h-[16rem] flex flex-col">
          <div class="flex items-start justify-between mb-8">
            <span class="font-[Archivo] font-black text-5xl md:text-6xl leading-none tracking-[-0.04em] text-[#fafafa]/15 group-hover:text-white/25 transition-colors">
              {step.step}
            </span>
            <span class="w-2 h-2 bg-[#ea580c] group-hover:bg-white transition-colors"></span>
          </div>
          <h3 class="font-[Archivo] font-black uppercase tracking-tight leading-[0.95] text-lg md:text-xl mb-4 group-hover:text-white transition-colors">
            {step.title}
          </h3>
          <p class="text-xs md:text-sm text-[#fafafa]/50 leading-relaxed group-hover:text-white/80 transition-colors mt-auto">
            {step.description}
          </p>
          {i < site.process.length - 1 && (
            <span class="hidden xl:block absolute top-1/2 -right-[7px] z-10 text-[#ea580c] group-hover:text-white text-sm">
              ▸
            </span>
          )}
        </article>
      ))
    }
  </div>
</section>
