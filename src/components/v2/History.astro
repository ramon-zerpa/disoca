---
import { site } from "../../data/site";
const { history } = site;
---

<section class="grid lg:grid-cols-2 border-y border-[#262626]">
  <div class="relative min-h-[22rem] lg:min-h-0 overflow-hidden">
    <img
      src={history.image}
      alt="Historia de DISOCA"
      class="absolute inset-0 w-full h-full object-cover grayscale-[25%]"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/85 via-transparent to-transparent"></div>
    <div class="absolute bottom-6 left-6 font-mono text-[10px] tracking-[0.2em] uppercase text-[#fafafa]/70">
      Fig. 02 — Trayectoria
    </div>
    <div class="absolute top-6 left-6 bg-[#ea580c] text-white font-mono text-[10px] tracking-[0.2em] uppercase px-3 py-1.5">
      Est. {site.since}
    </div>
  </div>

  <div class="px-5 md:px-10 py-16 md:py-24 lg:border-l border-[#262626]">
    <div class="font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-[#ea580c] mb-10">
      03 / Historia
    </div>
    <h2 class="font-[Archivo] font-black uppercase leading-[0.85] tracking-[-0.04em] text-[clamp(2.4rem,6vw,5.5rem)] mb-10">
      Nuestra<br />historia
    </h2>
    <div class="space-y-6 max-w-xl">
      {
        history.text.map((p) => (
          <p class="text-[#fafafa]/65 leading-relaxed text-sm md:text-base">{p}</p>
        ))
      }
    </div>
    <a
      href="#servicios"
      class="inline-flex items-center gap-3 mt-10 font-mono text-[11px] tracking-[0.2em] uppercase text-[#ea580c] hover:gap-5 transition-all cursor-pointer"
    >
      Conoce nuestros servicios <span>→</span>
    </a>
  </div>
</section>
