---
import { site } from "../../data/site";
---

<section class="px-5 md:px-10 py-24 md:py-36">
  <div class="flex items-baseline justify-between font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-[#fafafa]/50 mb-12">
    <span class="text-[#ea580c]">05 / Áreas de desempeño</span>
    <span class="hidden sm:inline">5 disciplinas</span>
  </div>

  <h2 class="font-[Archivo] font-black uppercase leading-[0.85] tracking-[-0.04em] text-[clamp(2.6rem,8vw,7.5rem)] mb-14 md:mb-20">
    Áreas de<br /><span class="text-[#ea580c]">desempeño</span>
  </h2>

  <div class="grid grid-cols-2 lg:grid-cols-6 gap-px bg-[#262626] border border-[#262626]">
    {
      site.areas.map((area, i) => (
        <article
          class={`group relative bg-[#0a0a0a] overflow-hidden cursor-pointer ${
            i === 0 ? "col-span-2 lg:col-span-3 aspect-[16/10]" : ""
          } ${i === 1 ? "col-span-2 lg:col-span-3 aspect-[16/10]" : ""} ${
            i >= 2 ? "col-span-2 sm:col-span-1 lg:col-span-2 aspect-square lg:aspect-[4/5]" : ""
          }`}
        >
          <img
            src={area.image}
            alt={area.title}
            class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/90 via-[#0a0a0a]/20 to-transparent"></div>
          <div class="absolute inset-0 p-5 md:p-7 flex flex-col justify-between">
            <span class="font-mono text-[10px] tracking-[0.2em] text-[#fafafa]/60 group-hover:text-[#ea580c] transition-colors">
              A-{String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="font-[Archivo] font-black uppercase tracking-tight leading-[0.9] text-xl md:text-3xl group-hover:translate-x-1.5 transition-transform duration-300">
              {area.title}
            </h3>
          </div>
          <div class="absolute inset-0 border-2 border-[#ea580c] opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
        </article>
      ))
    }
  </div>
</section>
