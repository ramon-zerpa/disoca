---
import { site } from "../../data/site";
const { hero } = site;
---

<section id="top" class="relative min-h-svh flex flex-col justify-end overflow-hidden">
  <!-- Imagen de fondo -->
  <div class="absolute inset-0">
    <img
      src={hero.image}
      alt=""
      class="w-full h-full object-cover opacity-40 grayscale-[30%]"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/55 to-[#0a0a0a]/25"></div>
  </div>

  <!-- Retícula blueprint -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.14]"
    style="background-image: linear-gradient(#fafafa 1px, transparent 1px), linear-gradient(90deg, #fafafa 1px, transparent 1px); background-size: 80px 80px;">
  </div>
  <div class="absolute top-24 left-5 md:left-10 w-4 h-4 border-l border-t border-[#fafafa]/40 pointer-events-none"></div>
  <div class="absolute top-24 right-5 md:right-10 w-4 h-4 border-r border-t border-[#fafafa]/40 pointer-events-none"></div>

  <!-- Meta superior -->
  <div class="relative z-10 px-5 md:px-10 pt-28 flex justify-between font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-[#fafafa]/60">
    <span>Est. {site.since} — Barinas, VE</span>
    <span class="hidden sm:inline">VE · PA · RD · CO</span>
    <span class="text-[#ea580c]">Soluciones integradas</span>
  </div>

  <!-- Titular gigante -->
  <div class="relative z-10 px-5 md:px-10 mt-6 mb-10 md:mb-14">
    <h1 class="font-[Archivo] font-black uppercase leading-[0.82] tracking-[-0.04em]">
      <span class="v2-reveal block text-[clamp(3.2rem,12.5vw,11.5rem)]">Ingeniería</span>
      <span class="v2-reveal block text-[clamp(3.2rem,12.5vw,11.5rem)] text-transparent [-webkit-text-stroke:2px_#fafafa]">Construcción</span>
    </h1>

    <div class="mt-8 md:mt-10 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
      <p class="max-w-md text-sm md:text-base text-[#fafafa]/70 leading-relaxed">
        {hero.description}
      </p>
      <div class="flex items-center gap-6">
        <a
          href="#portafolio"
          class="group inline-flex items-center gap-3 font-mono text-[11px] tracking-[0.2em] uppercase border border-[#fafafa]/30 px-6 py-4 hover:bg-[#ea580c] hover:border-[#ea580c] hover:text-white transition-all duration-200 cursor-pointer"
        >
          Ver proyectos
          <span class="group-hover:translate-y-0.5 transition-transform">↓</span>
        </a>
        <a
          href="#contacto"
          class="hidden sm:inline-flex items-center gap-3 font-mono text-[11px] tracking-[0.2em] uppercase text-[#fafafa]/60 hover:text-[#ea580c] transition-colors cursor-pointer"
        >
          Contacto →
        </a>
      </div>
    </div>
  </div>

  <!-- Barra inferior -->
  <div class="relative z-10 border-t border-[#fafafa]/15 px-5 md:px-10 py-4 flex items-center justify-between font-mono text-[10px] tracking-[0.2em] uppercase text-[#fafafa]/50">
    <span class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 bg-[#ea580c] animate-pulse"></span>
      Desde {site.since}
    </span>
    <span class="hidden md:inline">Ingeniería · Procura · Construcción</span>
    <span>Scroll ↓</span>
  </div>
</section>

<style>
  .v2-reveal {
    opacity: 0;
    transform: translateY(40px);
    animation: v2-hero-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .v2-reveal:nth-child(2) { animation-delay: 0.12s; }
  @keyframes v2-hero-in {
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-reveal { opacity: 1; transform: none; animation: none; }
  }
</style>
