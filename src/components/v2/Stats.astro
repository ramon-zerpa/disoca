---
import { site } from "../../data/site";
---

<section class="border-y border-[#262626]">
  <div class="grid grid-cols-2 lg:grid-cols-4">
    {
      site.counters.map((c, i) => (
        <div
          class={`v2-stat px-5 md:px-10 py-10 md:py-16 border-[#262626] ${
            i % 2 === 0 ? "border-r" : ""
          } ${i < 2 ? "border-b lg:border-b-0" : ""} ${i < 3 ? "lg:border-r" : ""} ${i === 1 ? "lg:border-r" : ""} ${i === 2 ? "border-r lg:border-r" : ""}`}
        >
          <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-[#fafafa]/40 mb-4">
            S-{String(i + 1).padStart(2, "0")}
          </div>
          <div class="font-[Archivo] font-black tracking-[-0.04em] leading-none text-[clamp(3rem,7vw,6rem)]">
            <span class="v2-counter" data-target={c.value}>0</span>
            <span class="text-[#ea580c]">{c.suffix}</span>
          </div>
          <div class="mt-4 text-xs md:text-sm text-[#fafafa]/60 uppercase tracking-wider">
            {c.label}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const counters = document.querySelectorAll<HTMLElement>(".v2-counter");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.target ?? 0);
    if (reduceMotion) {
      el.textContent = String(target);
      return;
    }
    const duration = 1400;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 4);
      el.textContent = String(Math.round(eased * target));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          animate(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.4 }
  );
  counters.forEach((c) => io.observe(c));
</script>
