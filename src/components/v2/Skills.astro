---
import { site } from "../../data/site";
---

<section class="px-5 md:px-10 py-24 md:py-36">
  <div class="flex items-baseline justify-between font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-[#fafafa]/50 mb-12">
    <span class="text-[#ea580c]">04 / Capacidades</span>
    <span class="hidden sm:inline">Nivel de ejecución</span>
  </div>

  <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
    <h2 class="lg:col-span-5 font-[Archivo] font-black uppercase leading-[0.85] tracking-[-0.04em] text-[clamp(2.4rem,6vw,5.5rem)] lg:sticky lg:top-28">
      Habilidades<br />
      <span class="text-transparent [-webkit-text-stroke:2px_#fafafa]">técnicas</span>
    </h2>

    <div class="lg:col-span-7 space-y-0 border-t border-[#262626]">
      {
        site.skills.map((skill, i) => (
          <div class="v2-skill border-b border-[#262626] py-7 md:py-9" data-percent={skill.percent}>
            <div class="flex items-baseline justify-between gap-6 mb-4">
              <span class="font-[Archivo] font-black uppercase tracking-tight text-lg md:text-2xl">
                <span class="font-mono font-normal text-xs text-[#ea580c] mr-3">0{i + 1}</span>
                {skill.name}
              </span>
              <span class="font-mono text-sm md:text-base text-[#fafafa]/70">
                <span class="v2-skill-num" data-target={skill.percent}>0</span>%
              </span>
            </div>
            <div class="h-px bg-[#262626] relative">
              <div
                class="v2-skill-bar absolute left-0 top-0 h-px bg-[#ea580c]"
                style="width: 0%"
              ></div>
              <div class="absolute right-0 -top-1 w-px h-2 bg-[#262626]"></div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const skills = document.querySelectorAll<HTMLElement>(".v2-skill");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const run = (el: HTMLElement) => {
    const percent = Number(el.dataset.percent ?? 0);
    const bar = el.querySelector<HTMLElement>(".v2-skill-bar");
    const num = el.querySelector<HTMLElement>(".v2-skill-num");
    if (reduceMotion) {
      if (bar) bar.style.width = `${percent}%`;
      if (num) num.textContent = String(percent);
      return;
    }
    const duration = 1200;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 4);
      if (bar) bar.style.width = `${eased * percent}%`;
      if (num) num.textContent = String(Math.round(eased * percent));
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          run(e.target as HTMLElement);
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.5 }
  );
  skills.forEach((s) => io.observe(s));
</script>
