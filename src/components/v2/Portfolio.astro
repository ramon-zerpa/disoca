---
const gallery = Array.from({ length: 13 }, (_, i) => ({
  src: `/images/obra-${String(i + 1).padStart(2, "0")}.jpg`,
  ref: `OBRA-${String(i + 1).padStart(2, "0")}`,
}));
---

<section id="portafolio" class="px-5 md:px-10 py-24 md:py-36">
  <div class="flex items-baseline justify-between font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-[#fafafa]/50 mb-12">
    <span class="text-[#ea580c]">07 / Portafolio</span>
    <span class="hidden sm:inline">Registro fotográfico</span>
  </div>

  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14 md:mb-20">
    <h2 class="font-[Archivo] font-black uppercase leading-[0.85] tracking-[-0.04em] text-[clamp(2.6rem,8vw,7.5rem)]">
      Obras<br /><span class="text-transparent [-webkit-text-stroke:2px_#fafafa]">destacadas</span>
    </h2>
    <a
      href="#contacto"
      class="group inline-flex items-center gap-3 font-mono text-[11px] tracking-[0.2em] uppercase border border-[#fafafa]/30 px-6 py-4 hover:bg-[#ea580c] hover:border-[#ea580c] transition-all duration-200 cursor-pointer self-start md:self-auto"
    >
      Contáctanos <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>

  <div class="columns-2 md:columns-3 xl:columns-4 gap-3 space-y-3">
    {
      gallery.map((img) => (
        <figure class="group relative overflow-hidden border border-[#262626] break-inside-avoid cursor-pointer">
          <img
            src={img.src}
            alt={img.ref}
            class="w-full h-auto grayscale-[40%] group-hover:grayscale-0 group-hover:scale-[1.04] transition-all duration-500"
            loading="lazy"
          />
          <figcaption class="absolute bottom-0 left-0 right-0 flex justify-between items-center px-3 py-2 bg-[#0a0a0a]/85 backdrop-blur-sm font-mono text-[9px] tracking-[0.2em] uppercase text-[#fafafa]/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <span>{img.ref}</span>
            <span class="text-[#ea580c]">DISOCA</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
