---
import { site } from "../data/site";
const { history } = site;
---

<section class="py-24 lg:py-32 bg-white relative overflow-hidden">
  <div class="absolute -right-20 top-20 w-64 h-64 bg-accent-500/5 rounded-full blur-3xl"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <span class="text-accent-500 font-semibold text-sm tracking-wider uppercase">
          Trayectoria
        </span>
        <h2 class="text-4xl lg:text-5xl font-black text-navy-950 mt-3 leading-tight">
          {history.title}
        </h2>
        <div class="mt-8 space-y-4">
          {
            history.text.map((p) => (
              <p class="text-navy-600 text-lg leading-relaxed">{p}</p>
            ))
          }
        </div>
        <a
          href="#servicios"
          class="inline-flex items-center gap-2 mt-8 text-accent-500 hover:text-accent-600 font-semibold transition-colors group"
        >
          Conoce nuestros servicios
          <svg
            class="w-4 h-4 group-hover:translate-x-1 transition-transform"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="relative">
        <div class="absolute -inset-4 bg-accent-500/10 rounded-3xl blur-2xl"></div>
        <div class="relative rounded-2xl overflow-hidden">
          <img
            src={history.image}
            alt="Historia de DISOCA"
            class="w-full h-auto object-cover rounded-2xl"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/60 to-transparent rounded-2xl"></div>
          <div class="absolute bottom-6 left-6 right-6">
            <div class="bg-white/10 backdrop-blur-md rounded-xl p-4 inline-block">
              <span class="text-3xl font-black text-white">{site.counters[0].value}</span>
              <span class="text-accent-500 text-2xl font-black">+</span>
              <span class="block text-white/70 text-sm mt-1">años de experiencia</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
