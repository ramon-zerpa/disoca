---
import { site } from "../data/site";
---

<section class="py-24 lg:py-32 bg-navy-950 relative overflow-hidden">
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-accent-500/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-20">
      <span class="text-accent-500 font-semibold text-sm tracking-wider uppercase">
        Cómo trabajamos
      </span>
      <h2 class="text-4xl lg:text-5xl font-black text-white mt-3 leading-tight">
        Nuestro Proceso Integrado
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        site.process.map((step, i) => (
          <div class="relative group">
            <div class="bg-white/5 border border-white/10 rounded-2xl p-8 h-full backdrop-blur-sm hover:border-accent-500/30 hover:bg-white/[0.07] transition-all duration-300">
              <span class="text-6xl font-black text-accent-500/20 group-hover:text-accent-500/40 transition-colors">
                {step.step}
              </span>
              <h3 class="text-xl font-bold text-white mt-4 mb-3">{step.title}</h3>
              <p class="text-white/50 text-sm leading-relaxed">{step.description}</p>
            </div>

            {i < site.process.length - 1 && (
              <div class="hidden lg:block absolute top-1/2 -right-3 z-10">
                <svg class="w-6 h-6 text-accent-500/30" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" />
                </svg>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
