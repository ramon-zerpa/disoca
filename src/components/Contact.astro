---
import { site } from "../data/site";
---

<section id="contacto" class="py-24 lg:py-32 bg-slate-50 relative overflow-hidden">
  <div class="absolute -left-20 top-40 w-64 h-64 bg-accent-500/5 rounded-full blur-3xl"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-accent-500 font-semibold text-sm tracking-wider uppercase">
        Hablemos
      </span>
      <h2 class="text-4xl lg:text-5xl font-black text-navy-950 mt-3 leading-tight">
        Contáctanos
      </h2>
      <p class="text-navy-600 text-lg mt-4">
        Presencia en 4 países de Latinoamérica. Estamos listos para tu próximo proyecto.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8">
      <div class="lg:col-span-3 space-y-4">
        {
          site.offices.map((office, i) => (
            <details
              class={`group bg-white rounded-2xl border border-navy-950/5 overflow-hidden ${i === 0 ? "ring-2 ring-accent-500/20" : ""}`}
              open={i === 0}
            >
              <summary class="flex items-center justify-between p-6 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 bg-accent-500/10 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <span class="text-lg font-bold text-navy-950">{office.country}</span>
                </div>
                <svg
                  class="w-5 h-5 text-navy-400 group-open:rotate-180 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-6 pt-0 space-y-3">
                <div class="flex items-start gap-3">
                  <svg class="w-4 h-4 text-navy-400 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="text-navy-600 text-sm">{office.address}</span>
                </div>
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-navy-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span class="text-navy-600 text-sm">{office.phone}</span>
                </div>
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-navy-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span class="text-navy-600 text-sm">{office.schedule}</span>
                </div>
              </div>
            </details>
          ))
        }
      </div>

      <div class="lg:col-span-2">
        <div class="bg-navy-950 rounded-2xl p-8 lg:p-10 h-full">
          <h3 class="text-2xl font-bold text-white mb-2">Escríbenos</h3>
          <p class="text-white/50 text-sm mb-8">
            Cuéntanos sobre tu proyecto y te responderemos a la brevedad.
          </p>

          <form class="space-y-5" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
            <div>
              <label class="block text-sm font-medium text-white/70 mb-2">Nombre</label>
              <input
                type="text"
                name="name"
                required
                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/30 focus:outline-none focus:border-accent-500 transition-colors"
                placeholder="Tu nombre"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-white/70 mb-2">Email</label>
              <input
                type="email"
                name="email"
                required
                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/30 focus:outline-none focus:border-accent-500 transition-colors"
                placeholder="tu@email.com"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-white/70 mb-2">Mensaje</label>
              <textarea
                name="message"
                rows="4"
                required
                class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/30 focus:outline-none focus:border-accent-500 transition-colors resize-none"
                placeholder="Cuéntanos sobre tu proyecto..."
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-accent-500 hover:bg-accent-600 text-white font-semibold py-4 rounded-xl transition-all hover:shadow-lg hover:shadow-accent-500/25"
            >
              Enviar mensaje
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
