---
import { site } from "../data/site";
---

<section id="nosotros" class="py-24 lg:py-32 bg-navy-950 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent-500/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-16">
      <span class="text-accent-500 font-semibold text-sm tracking-wider uppercase">
        Quiénes somos
      </span>
      <h2 class="text-4xl lg:text-5xl font-black text-white mt-3 leading-tight">
        Nuestra Empresa
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 mb-20">
      <div class="bg-white/5 border border-white/10 rounded-2xl p-8 lg:p-10 backdrop-blur-sm hover:border-accent-500/30 transition-colors">
        <div class="w-12 h-12 bg-accent-500/10 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">Visión</h3>
        <p class="text-white/60 leading-relaxed">{site.vision}</p>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-8 lg:p-10 backdrop-blur-sm hover:border-accent-500/30 transition-colors">
        <div class="w-12 h-12 bg-accent-500/10 rounded-xl flex items-center justify-center mb-6">
          <svg class="w-6 h-6 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-4">Misión</h3>
        <p class="text-white/60 leading-relaxed">{site.mission}</p>
      </div>
    </div>

    <div class="relative rounded-2xl overflow-hidden">
      <img
        src={site.empresaImage}
        alt="DISOCA - Nuestra Empresa"
        class="w-full h-64 lg:h-80 object-cover rounded-2xl"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-navy-950/70 to-transparent"></div>
    </div>
  </div>
</section>
