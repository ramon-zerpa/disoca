---
import { site } from "../data/site";
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href="#inicio" class="flex items-center gap-3 group">
        <img
          src={site.logo}
          alt={site.name}
          class="h-10 w-auto object-contain"
        />
      </a>

      <nav class="hidden lg:flex items-center gap-8">
        {
          site.nav.map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-white/80 header-link hover:text-accent-400 transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <button
        id="mobile-toggle"
        class="lg:hidden w-10 h-10 flex items-center justify-center text-white"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden bg-navy-950/95 backdrop-blur-lg">
    <nav class="px-4 pb-6 pt-2 flex flex-col gap-4">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class="text-base font-medium text-white/80 hover:text-accent-400 transition-colors py-2"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");

  const onScroll = () => {
    if (window.scrollY > 60) {
      header.classList.add(
        "bg-navy-950/90",
        "backdrop-blur-lg",
        "shadow-lg",
      );
      header.classList.remove("bg-transparent");
    } else {
      header.classList.remove(
        "bg-navy-950/90",
        "backdrop-blur-lg",
        "shadow-lg",
      );
      header.classList.add("bg-transparent");
    }
  };

  window.addEventListener("scroll", onScroll);
  onScroll();

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => menu?.classList.add("hidden"));
  });
</script>
