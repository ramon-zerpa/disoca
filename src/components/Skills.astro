---
import { site } from "../data/site";
---

<section class="py-24 lg:py-32 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-accent-500 font-semibold text-sm tracking-wider uppercase">
        Capacidades
      </span>
      <h2 class="text-4xl lg:text-5xl font-black text-navy-950 mt-3 leading-tight">
        Nuestras Habilidades
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="relative">
        <img
          src={site.skillsImage}
          alt="Habilidades DISOCA"
          class="rounded-2xl object-cover w-full h-auto"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-navy-950/30 rounded-2xl"></div>
      </div>

      <div class="space-y-6">
        {
          site.skills.map((skill) => (
            <div class="group">
              <div class="flex items-center justify-between mb-2">
                <span class="font-semibold text-navy-950">{skill.name}</span>
                <span class="text-sm font-bold text-accent-500">{skill.percent}%</span>
              </div>
              <div class="h-2 bg-navy-950/10 rounded-full overflow-hidden">
                <div
                  class="h-full bg-gradient-to-r from-accent-500 to-accent-400 rounded-full transition-all duration-1000 ease-out"
                  style={`width: ${skill.percent}%`}
                ></div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
