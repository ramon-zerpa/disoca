---
import { site } from "../data/site";
const { hero } = site;
---

<section
  id="inicio"
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-navy-950"
>
  <div class="absolute inset-0">
    <img
      src={hero.image}
      alt="Ingeniería y construcción"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950/95 via-navy-900/85 to-navy-800/80"></div>
  </div>

  <div class="absolute top-1/4 -right-32 w-96 h-96 bg-accent-500/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-1/4 -left-32 w-80 h-80 bg-accent-500/5 rounded-full blur-3xl"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-24">
    <div class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-4 py-2 mb-8">
      <span class="w-2 h-2 bg-accent-500 rounded-full animate-pulse"></span>
      <span class="text-sm text-white/70 font-medium">
        Desde {site.since} construyendo el futuro
      </span>
    </div>

    <h1 class="text-5xl sm:text-6xl lg:text-8xl font-black text-white leading-[0.9] tracking-tight mb-6">
      {hero.title}
      <span class="block text-accent-500 mt-2">{hero.subtitle}</span>
    </h1>

    <p class="max-w-2xl mx-auto text-lg sm:text-xl text-white/60 leading-relaxed mb-12">
      {hero.description}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={hero.cta[0].href}
        class="group inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-semibold px-8 py-4 rounded-xl transition-all hover:shadow-lg hover:shadow-accent-500/25 hover:-translate-y-0.5"
      >
        {hero.cta[0].label}
        <svg
          class="w-4 h-4 group-hover:translate-x-1 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href={hero.cta[1].href}
        class="inline-flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold px-8 py-4 rounded-xl transition-all hover:-translate-y-0.5"
      >
        {hero.cta[1].label}
      </a>
    </div>

    <div class="mt-20 grid grid-cols-2 sm:grid-cols-4 gap-8 max-w-3xl mx-auto">
      {
        site.counters.map((c) => (
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-black text-white">
              {c.value}
              <span class="text-accent-500">{c.suffix}</span>
            </div>
            <div class="text-xs sm:text-sm text-white/40 mt-1">{c.label}</div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-5 h-5 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
