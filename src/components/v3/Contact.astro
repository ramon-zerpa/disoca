---
import { site } from "../../data/site";
---

<section id="contacto" class="relative bg-paper">
  <div class="px-5 md:px-10 lg:px-16 py-16 md:py-24">
    <div class="flex items-end justify-between gap-6 mb-12">
      <div>
        <p class="font-tech text-[10px] tracking-[0.3em] uppercase text-blueprint mb-3">09 · CONTACTO</p>
        <h2 class="font-display uppercase text-[clamp(2rem,6vw,4.5rem)] leading-none">Hablemos de tu obra</h2>
      </div>
      <span class="hidden md:inline font-tech text-[10px] tracking-[0.25em] uppercase text-steel">
        2 PAÍSES · <span class="text-signal">DISPONIBLES</span>
      </span>
    </div>

    <div class="grid lg:grid-cols-12 gap-10">
      <!-- Formulario -->
      <div class="lg:col-span-6">
        <form
          action="https://formspree.io/f/mzepweor"
          method="POST"
          class="grid sm:grid-cols-2 gap-5"
        >
          <input type="hidden" name="_subject" value="Nuevo mensaje desde disoca.com" />
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
          <label class="block sm:col-span-1">
            <span class="font-tech text-[10px] tracking-[0.25em] uppercase text-steel mb-1 block">Nombre *</span>
            <input
              type="text"
              name="nombre"
              required
              class="w-full border border-line bg-white px-4 py-3 font-body text-sm text-ink placeholder:text-steel/60 focus:outline-none focus:border-blueprint focus:ring-1 focus:ring-blueprint transition-colors"
              placeholder="Tu nombre"
            />
          </label>
          <label class="block sm:col-span-1">
            <span class="font-tech text-[10px] tracking-[0.25em] uppercase text-steel mb-1 block">Empresa</span>
            <input
              type="text"
              name="empresa"
              class="w-full border border-line bg-white px-4 py-3 font-body text-sm text-ink placeholder:text-steel/60 focus:outline-none focus:border-blueprint focus:ring-1 focus:ring-blueprint transition-colors"
              placeholder="Empresa / Organización"
            />
          </label>
          <label class="block sm:col-span-1">
            <span class="font-tech text-[10px] tracking-[0.25em] uppercase text-steel mb-1 block">Correo *</span>
            <input
              type="email"
              name="correo"
              required
              class="w-full border border-line bg-white px-4 py-3 font-body text-sm text-ink placeholder:text-steel/60 focus:outline-none focus:border-blueprint focus:ring-1 focus:ring-blueprint transition-colors"
              placeholder="correo@empresa.com"
            />
          </label>
          <label class="block sm:col-span-1">
            <span class="font-tech text-[10px] tracking-[0.25em] uppercase text-steel mb-1 block">Teléfono</span>
            <input
              type="tel"
              name="telefono"
              class="w-full border border-line bg-white px-4 py-3 font-body text-sm text-ink placeholder:text-steel/60 focus:outline-none focus:border-blueprint focus:ring-1 focus:ring-blueprint transition-colors"
              placeholder="+58 ..."
            />
          </label>
          <label class="block sm:col-span-2">
            <span class="font-tech text-[10px] tracking-[0.25em] uppercase text-steel mb-1 block">Mensaje *</span>
            <textarea
              name="mensaje"
              required
              rows="5"
              class="w-full border border-line bg-white px-4 py-3 font-body text-sm text-ink placeholder:text-steel/60 focus:outline-none focus:border-blueprint focus:ring-1 focus:ring-blueprint transition-colors resize-none"
              placeholder="Cuéntanos sobre tu proyecto..."
            ></textarea>
          </label>
          <div class="sm:col-span-2 flex items-center gap-4">
            <button
              type="submit"
              class="bg-ink text-paper font-tech text-[11px] tracking-[0.2em] uppercase px-7 py-4 hover:bg-blueprint transition-colors duration-200 cursor-pointer"
            >
              Enviar consulta →
            </button>
          </div>
        </form>
        <div id="form-success" class="hidden mt-5 border border-blueprint/30 bg-blueprint/5 p-5">
          <p class="font-tech text-xs tracking-[0.15em] uppercase text-blueprint">Mensaje enviado correctamente</p>
          <p class="font-body text-sm text-ink/70 mt-1">Nos pondremos en contacto contigo pronto.</p>
        </div>
      </div>

      <!-- Oficinas -->
      <div class="lg:col-span-5 lg:col-start-8 mt-10 md:mt-12 lg:mt-0">
        <p class="font-tech text-[10px] tracking-[0.3em] uppercase text-blueprint mb-4">Oficinas</p>
        <div class="space-y-3">
          {
            site.offices.map((o, i) => (
              <div class="border border-line bg-white p-4">
                <div class="flex items-center justify-between mb-1">
                  <h3 class="font-display text-lg uppercase tracking-wide text-ink">0{i + 1} · {o.country}</h3>
                  <span class="font-tech text-[9px] tracking-[0.2em] uppercase text-blueprint">OFIC-0{i + 1}</span>
                </div>
                <p class="font-body text-sm text-ink/70 leading-relaxed">{o.address}</p>
                <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 mt-2">
                  <a href={`tel:${o.phone.replace(/\s+/g, "")}`} class="inline-flex items-center gap-1.5 font-tech text-xs text-blueprint hover:text-signal transition-colors">
                    <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 shrink-0" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1.003 1.003 0 011.01-.24c1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.1.31.03.66-.25 1.02l-2.2 2.2z"/></svg>
                    {o.phone}
                  </a>
                  <a href="mailto:info@disoca.com" class="inline-flex items-center gap-1.5 font-tech text-xs text-blueprint hover:text-signal transition-colors">
                    <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 shrink-0" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                    info@disoca.com
                  </a>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  if (window.location.search.includes("success=1")) {
    const el = document.getElementById("form-success");
    if (el) el.classList.remove("hidden");
    history.replaceState(null, "", window.location.pathname);
  }
</script>