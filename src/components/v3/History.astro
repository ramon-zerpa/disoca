---
import { site } from "../../data/site";
---

<section id="historia" class="relative bg-paper border-t border-line">
  <div class="px-5 md:px-10 lg:px-16 py-16 md:py-24">
    <div class="flex items-end justify-between gap-6 mb-12">
      <div>
        <p class="font-tech text-[10px] tracking-[0.3em] uppercase text-blueprint mb-3">02 · NOSOTROS</p>
        <h2 class="font-display uppercase text-[clamp(2rem,6vw,4.5rem)] leading-none">Nuestra historia</h2>
      </div>
      <span class="hidden md:inline font-tech text-[10px] tracking-[0.25em] uppercase text-steel">
        EST. {site.since}
      </span>
    </div>

    <div class="grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-6 relative">
        <div class="relative border border-ink/15 bg-white p-3">
          <div class="absolute -top-px -left-px w-4 h-4 border-t-2 border-l-2 border-blueprint" aria-hidden="true"></div>
          <div class="absolute -bottom-px -right-px w-4 h-4 border-b-2 border-r-2 border-blueprint" aria-hidden="true"></div>
          <img
            src={site.history.image}
            alt="Historia de DISOCA"
            class="w-full aspect-[4/3] object-cover grayscale-[15%]"
            loading="lazy"
          />
          <div class="mt-2 flex justify-between font-tech text-[9px] tracking-[0.2em] uppercase text-steel">
            <span>Fig. 02 — Trayectoria</span>
            <span class="text-blueprint">{site.since} → {new Date().getFullYear()}</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 space-y-5">
        {
          site.history.text.map((p) => (
            <p class="font-body text-sm md:text-base text-ink/70 leading-relaxed">{p}</p>
          ))
        }
      </div>
    </div>
  </div>
</section>