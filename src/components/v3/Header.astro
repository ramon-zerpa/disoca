---
import { site } from "../../data/site";
---

<header class="fixed top-0 left-0 right-0 z-50 bg-paper/95 backdrop-blur border-b border-line">
  <div class="relative">
    <div class="h-[3px] bg-blueprint" aria-hidden="true"></div>
    <div class="flex items-center justify-between px-5 md:px-10 py-4">
      <a href="#top" class="flex items-center gap-3" aria-label="DISOCA — Inicio">
        <img
          src="/images/logo-disoca-transparent.png"
          alt="DISOCA"
          class="h-10 md:h-11 w-auto"
          width="500"
          height="151"
        />
        <span class="hidden md:inline font-tech text-[9px] tracking-[0.25em] uppercase text-steel leading-tight">
          Ing. &amp; Const.<br />desde {site.since}
        </span>
      </a>

      <nav class="hidden lg:flex items-center gap-7 font-tech text-[11px] tracking-[0.15em] uppercase">
        {
          site.nav.map((item, i) => (
            <a
              href={item.href}
              class="group flex items-center gap-1.5 text-ink/80 hover:text-blueprint transition-colors duration-200"
            >
              <span class="text-blueprint">{String(i + 1).padStart(2, "0")}</span>
              <span>{item.label}</span>
            </a>
          ))
        }
      </nav>

      <button
        id="v3-menu-btn"
        class="lg:hidden font-tech text-[11px] tracking-[0.15em] uppercase flex items-center gap-2 text-ink"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="v3-mobile-menu"
      >
        <span>Menú</span>
        <span class="text-signal">+</span>
      </button>
    </div>
  </div>
</header>

<!-- Menú móvil: overlay full-screen FUERA del header (el backdrop-blur del header
     lo convertiría en containing block y el fixed no cubriría la pantalla) -->
<div
  id="v3-mobile-menu"
  class="hidden lg:hidden fixed inset-0 z-[60] bg-paper flex-col overflow-y-auto"
  aria-hidden="true"
>
  <div class="h-[3px] bg-signal" aria-hidden="true"></div>
  <div class="sticky top-0 bg-paper flex items-center justify-between px-5 py-4 border-b border-line">
    <img
      src="/images/logo-disoca-transparent.png"
      alt="DISOCA"
      class="h-9 w-auto"
      width="500"
      height="151"
    />
    <button
      id="v3-menu-close"
      class="font-tech text-[11px] tracking-[0.15em] uppercase flex items-center gap-2 text-ink"
      aria-label="Cerrar menú"
    >
      <span>Cerrar</span>
      <span class="text-signal">×</span>
    </button>
  </div>

  <nav class="flex flex-col px-6 pt-6 pb-8">
    {
      site.nav.map((item, i) => (
        <a
          href={item.href}
          class="v3-mobile-link group flex items-baseline gap-4 py-4 border-b border-line"
        >
          <span class="font-tech text-xs text-blueprint">{String(i + 1).padStart(2, "0")}</span>
          <span class="font-display text-2xl uppercase tracking-wide text-ink group-hover:text-blueprint transition-colors">
            {item.label}
          </span>
        </a>
      ))
    }
  </nav>

  <div class="mt-auto px-6 py-6 border-t border-line flex items-center justify-between font-tech text-[10px] tracking-[0.25em] uppercase text-steel">
    <span>VE · RD</span>
    <span class="text-blueprint">EST. {site.since}</span>
  </div>
</div>

<script>
  const btn = document.getElementById("v3-menu-btn");
  const closeBtn = document.getElementById("v3-menu-close");
  const menu = document.getElementById("v3-mobile-menu");
  let open = false;

  const setMenu = (state: boolean) => {
    open = state;
    if (!menu || !btn || !closeBtn) return;
    menu.classList.toggle("hidden", !open);
    menu.classList.toggle("flex", open);
    menu.setAttribute("aria-hidden", String(!open));
    btn.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  };

  btn?.addEventListener("click", () => setMenu(true));
  closeBtn?.addEventListener("click", () => setMenu(false));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
  const mq = window.matchMedia("(min-width: 1024px)");
  mq.addEventListener?.("change", (e) => {
    if (e.matches) setMenu(false);
  });
</script>