---
import { site } from "../../data/site";
---

<section id="servicios" class="relative bg-paper">
  <div class="px-5 md:px-10 lg:px-16 py-16 md:py-24">
    <div class="flex items-end justify-between gap-6 mb-12">
      <div>
        <p class="font-tech text-[10px] tracking-[0.3em] uppercase text-blueprint mb-3">04 · SERVICIOS</p>
        <h2 class="font-display uppercase text-[clamp(2rem,6vw,4.5rem)] leading-none">Lo que hacemos</h2>
      </div>
      <span class="hidden md:inline font-tech text-[10px] tracking-[0.25em] uppercase text-steel">
        LÁM. 04 / 09
      </span>
    </div>

    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-5">
      {
        site.services.map((s, i) => (
          <article class="group relative border border-line bg-white hover:border-blueprint transition-colors duration-300">
            <div class="relative overflow-hidden">
              <img
                src={s.image}
                alt={s.title}
                class="w-full aspect-[4/3] object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <span class="absolute top-3 left-3 bg-paper/90 font-tech text-[9px] tracking-[0.25em] uppercase text-blueprint px-2 py-1">
                04.{i + 1}
              </span>
            </div>
            <div class="p-5">
              <h3 class="font-display text-2xl uppercase tracking-wide text-ink mb-2">{s.title}</h3>
              <p class="font-body text-sm text-ink/60 leading-relaxed">{s.description}</p>
            </div>
            <div class="mx-5 mb-5 h-px bg-line relative" aria-hidden="true">
              <span class="absolute -left-1 top-[-2px] w-0 h-0 border-y-[3px] border-y-transparent border-r-[6px] border-r-blueprint"></span>
              <span class="absolute -right-1 top-[-2px] w-0 h-0 border-y-[3px] border-y-transparent border-l-[6px] border-l-blueprint"></span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>