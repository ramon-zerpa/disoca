---
import { site } from "../../data/site";
---

<section id="proceso" class="relative bg-paper">
  <div class="px-5 md:px-10 lg:px-16 py-16 md:py-24">
    <div class="flex items-end justify-between gap-6 mb-12">
      <div>
        <p class="font-tech text-[10px] tracking-[0.3em] uppercase text-blueprint mb-3">07 · MÉTODO</p>
        <h2 class="font-display uppercase text-[clamp(2rem,6vw,4.5rem)] leading-none">Proceso integrado</h2>
      </div>
      <span class="hidden md:inline font-tech text-[10px] tracking-[0.25em] uppercase text-steel">
        4 ETAPAS · SECUENCIA
      </span>
    </div>

    <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-x-6 gap-y-10">
      {
        site.process.map((p, i) => (
          <div class="relative border-t-2 border-ink pt-6">
            <div class="flex items-baseline justify-between mb-4">
              <span class="font-display text-4xl text-blueprint leading-none">{p.step}</span>
              <span class="font-tech text-[9px] tracking-[0.25em] uppercase text-steel">
                ETAPA 0{i + 1}
              </span>
            </div>
            <h3 class="font-display text-xl uppercase tracking-wide text-ink mb-2">{p.title}</h3>
            <p class="font-body text-sm text-ink/60 leading-relaxed">{p.description}</p>
            <span class="absolute top-[-3px] left-0 w-4 h-[6px] bg-signal" aria-hidden="true"></span>
          </div>
        ))
      }
    </div>
  </div>
</section>