---
import { site } from "../../data/site";
const year = new Date().getFullYear();
---

<footer class="relative bg-paper border-t border-ink/15">
  <div class="px-5 md:px-10 lg:px-16 py-14 md:py-20">
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <img
          src="/images/logo-disoca-transparent.webp"
          alt="DISOCA"
          class="h-12 w-auto mb-5"
          width="500"
          height="151"
          loading="lazy"
        />
        <p class="font-body text-sm text-ink/60 leading-relaxed max-w-sm">
          {site.tagline} desde {site.since}. Soluciones integradas de ingeniería, procura y construcción en Latinoamérica.
        </p>
      </div>

      <div class="md:col-span-3">
        <h4 class="font-tech text-[10px] tracking-[0.25em] uppercase text-blueprint mb-5">Índice</h4>
        <ul class="space-y-3">
          {
            site.nav.map((item, i) => (
              <li>
                <a href={item.href} class="font-tech text-xs uppercase tracking-[0.15em] text-ink/70 hover:text-blueprint transition-colors">
                  {String(i + 1).padStart(2, "0")} {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-4">
        <h4 class="font-tech text-[10px] tracking-[0.25em] uppercase text-blueprint mb-5">Oficinas</h4>
        <ul class="space-y-2 font-tech text-xs text-ink/60">
          {site.offices.map((o) => (
            <li class="flex items-baseline justify-between gap-3">
              <span>{o.country}</span>
              <span class="text-steel">{o.phone}</span>
            </li>
          ))}
        </ul>
        <div class="mt-6 pt-5 border-t border-line">
          <p class="font-tech text-[10px] tracking-[0.25em] uppercase text-steel mb-3">Síguenos en Instagram</p>
          <a
            href="https://www.instagram.com/disoca_int/"
            target="_blank"
            rel="noopener"
            aria-label="Instagram de DISOCA"
            class="inline-flex items-center gap-2 text-blueprint hover:text-signal transition-colors"
          >
            <svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            <span class="font-tech text-xs tracking-[0.15em] uppercase">@disoca_int</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Palabra gigante de cierre -->
  <div class="overflow-hidden" aria-hidden="true">
    <div class="font-display uppercase text-center leading-[0.8] tracking-[-0.02em] text-[clamp(4rem,17vw,15rem)] text-ink/[0.07] select-none translate-y-[16%]">
      DISOCA
    </div>
  </div>

  <div class="border-t border-ink/15 px-5 md:px-10 lg:px-16 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 font-tech text-[9px] md:text-[10px] tracking-[0.25em] uppercase text-steel">
    <span>© {site.since} — {year} {site.name}</span>
    <span>Diseño y Programación: <a href="https://leadweb.dev/" target="_blank" class="font-bold text-blueprint hover:text-signal transition-colors">Leadweb.dev</a></span>
  </div>
</footer>