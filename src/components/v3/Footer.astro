---
import { site } from "../../data/site";
const year = new Date().getFullYear();
---

<footer class="relative bg-paper border-t border-ink/15">
  <div class="px-5 md:px-10 lg:px-16 py-14 md:py-20">
    <div class="grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <img
          src="/images/logo-disoca-transparent.webp"
          alt="DISOCA"
          class="h-12 w-auto mb-5"
          width="500"
          height="151"
          loading="lazy"
        />
        <p class="font-body text-sm text-ink/60 leading-relaxed max-w-sm">
          {site.tagline} desde {site.since}. Soluciones integradas de ingeniería, procura y construcción en Latinoamérica.
        </p>
      </div>

      <div class="md:col-span-3">
        <h4 class="font-tech text-[10px] tracking-[0.25em] uppercase text-blueprint mb-5">Índice</h4>
        <ul class="space-y-3">
          {
            site.nav.map((item, i) => (
              <li>
                <a href={item.href} class="font-tech text-xs uppercase tracking-[0.15em] text-ink/70 hover:text-blueprint transition-colors">
                  {String(i + 1).padStart(2, "0")} {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-4">
        <h4 class="font-tech text-[10px] tracking-[0.25em] uppercase text-blueprint mb-5">Oficinas</h4>
        <ul class="space-y-2 font-tech text-xs text-ink/60">
          {site.offices.map((o) => (
            <li class="flex items-baseline justify-between gap-3">
              <span>{o.country}</span>
              <span class="text-steel">{o.phone}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Palabra gigante de cierre -->
  <div class="overflow-hidden" aria-hidden="true">
    <div class="font-display uppercase text-center leading-[0.8] tracking-[-0.02em] text-[clamp(4rem,17vw,15rem)] text-ink/[0.07] select-none translate-y-[16%]">
      DISOCA
    </div>
  </div>

  <div class="border-t border-ink/15 px-5 md:px-10 lg:px-16 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 font-tech text-[9px] md:text-[10px] tracking-[0.25em] uppercase text-steel">
    <span>© {year} {site.name}</span>
    <span class="text-blueprint">Ingeniería y Construcción</span>
    <span>{site.since} — {year} · VE · RD</span>
  </div>
</footer>